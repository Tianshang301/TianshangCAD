{
  "mcpServers": {
    "cad-server": {
      "command": "python",
      "args": ["-m", "tianshangcad"],
      "env": {
        "TIANSHANGCAD_RUNTIME": "analytic",
        "TIANSHANGCAD_HEADLESS": "true",
        "TIANSHANGCAD_TEMP_DIR": "/tmp/tianshangcad"
      },
      "disabled": false,
      "autoApprove": [
        "cad_json",
        "cad_measure",
        "cad_render",
        "cad_validate"
      ]
    }
  }
}
